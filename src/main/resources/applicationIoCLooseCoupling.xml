<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->

    <bean id="userDatabase" class="com.ioc.loose.coupling.impl.UserDatabase"></bean>
    <bean id="webServiceDatabase" class="com.ioc.loose.coupling.impl.WebServiceDatabase"></bean>

    <bean id="userManager" class="com.ioc.loose.coupling.UserManager">
        <constructor-arg ref="webServiceDatabase"/>
    </bean>


    <!-- we can use this for different implementation using UserDatabase class

    <bean id="userManager" class="com.ioc.loose.coupling.UserManager">
        <constructor-arg ref="userDatabase"/>
    </bean>

    -->

</beans>